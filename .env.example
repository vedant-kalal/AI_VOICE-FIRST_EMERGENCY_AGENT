# Copy to .env — NEVER commit the real file.
# Same convention as ai-callcenter: IS_LOCAL=true reads this file; IS_LOCAL=false reads Azure Key Vault
# (secret name = env name with underscores stripped and upper-cased, e.g. OPENAI_API_KEY -> OPENAIAPIKEY).
IS_LOCAL=true

# ── Database ────────────────────────────────────────────────────────────────
# Zero-infra local dev (default if nothing is set):  sqlite:///./emergency.db
# Full stack (docker compose up -d db):  postgresql+psycopg2://emergency:emergency@localhost:5432/emergency
DATABASE_URL=sqlite:///./emergency.db
# Or build the URL from parts, like ai-callcenter does (used only when DATABASE_URL is empty):
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# ── OpenAI Realtime ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
VOICE_NAME=marin
SUMMARY_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
USE_EMBEDDINGS=false

# ── Twilio ──────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public host Twilio reaches (ngrok / tunnel), no scheme. Used in the <Stream> URL.
PUBLIC_HOST=
# Validate X-Twilio-Signature on the incoming-call webhook (recommended when exposed publicly)
TWILIO_VALIDATE_SIGNATURE=false

# ── Dispatch behaviour ──────────────────────────────────────────────────────
# approval   = assign_resource RESERVES the unit; a human approves it on the dashboard (safe default for real use)
# autonomous = assign_resource dispatches immediately (demo mode)
DISPATCH_MODE=autonomous
CRITICAL_SEVERITY=85
SMS_ENABLED=false
DEPARTMENT_WEBHOOK_URL=

# ── Geo ─────────────────────────────────────────────────────────────────────
# gazetteer = offline seeded landmarks | nominatim = OpenStreetMap | hybrid = gazetteer then nominatim
GEOCODER_PROVIDER=hybrid
DEFAULT_CITY=Ahmedabad
DEFAULT_COUNTRY_CODE=in
CITY_CENTER_LAT=23.0225
CITY_CENTER_LNG=72.5714
DUPLICATE_RADIUS_M=500
DUPLICATE_WINDOW_MIN=60

# ── External geo services ───────────────────────────────────────────────────
# Nearest department centre: overpass (OpenStreetMap, no key) | google_places (needs GOOGLE_MAPS_API_KEY) | seed
FACILITY_PROVIDER=overpass
# Road distance / ETA: osrm | google | haversine (no external call)
ROUTING_PROVIDER=osrm
GOOGLE_MAPS_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
EXTERNAL_HTTP_TIMEOUT_S=6
FACILITY_CACHE_TTL_S=86400
# Escalation ladder: make every seeded contact ring THIS number (your own phone) for a real end-to-end test
ESCALATION_DEMO_NUMBER=

# ── Demo helpers ────────────────────────────────────────────────────────────
SIMULATE_FLEET=true
SIM_SPEED_MULTIPLIER=12
DASHBOARD_API_KEY=
# Rehearse the PDF scenarios with no phone call: POST /api/dev/demo/{a|b|c|d}. Keep OFF anywhere public.
ENABLE_DEV_ENDPOINTS=false
